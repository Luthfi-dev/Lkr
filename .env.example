# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected at runtime from environment secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_STATUS: 'development' | 'production'
# Jika production, menonaktifkan seeder data otomatis agar berjalan secara real dan aman.
APP_STATUS="development"

# ==========================================================
# MYSQL DATABASE CONFIGURATION (Koneksi Database MySQL)
# ==========================================================
# Konfigurasi koneksi database MySQL online / lokal / Cloud SQL / RDS / PlanetScale.
# Jika variabel ini diisi, server akan otomatis terhubung ke database MySQL nyata,
# menjalankan migrasi tabel otomatis, dan menyimpan data akun & sesi secara persisten.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="lingkar_kebaikan"
MYSQL_SSL="false"
